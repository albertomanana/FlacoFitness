{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(git *)",
      "Bash(mvn *)",
      "Bash(./mvnw *)",
      "Bash(mvnw.cmd *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(java *)",
      "Bash(xargs wc *)",
      "Bash(xargs grep *)",
      "Bash(sed 's/\\\\.java//')",
      "Bash(sed 's/Service.java//')",
      "Read(//tmp/**)",
      "Bash(.\\\\mvnw.cmd clean *)",
      "Bash(./mvnw.cmd clean *)",
      "Bash(./mvnw.cmd dependency:resolve -DincludeArtifactIds=lombok)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "claude-sonnet-4-6",
  "effortLevel": "xhigh"
}
